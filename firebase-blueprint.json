{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Prospective clients and consultations submitted via website or registered by staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "additionalPhones": { "type": "array", "items": { "type": "string" } },
        "company": { "type": "string" },
        "jobTitle": { "type": "string" },
        "location": { "type": "string" },
        "industry": { "type": "string" },
        "emergencyLevel": { "type": "string" },
        "serviceRequested": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "contactedAt": { "type": "string" },
        "contactMethod": { "type": "string" },
        "estimatedValueDZD": { "type": "number" },
        "opportunityId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "email", "phone", "company", "serviceRequested", "status", "priority", "source"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Converted enterprise accounts and client directory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "company": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "additionalPhones": { "type": "array", "items": { "type": "string" } },
        "jobTitle": { "type": "string" },
        "location": { "type": "string" },
        "industry": { "type": "string" },
        "status": { "type": "string" },
        "website": { "type": "string" },
        "taxId": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["company", "name", "email", "phone", "status"]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "Commercial pipeline deals and revenue projections in DZD",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "stage": { "type": "string" },
        "expectedValueDZD": { "type": "number" },
        "probability": { "type": "number" },
        "expectedCloseDate": { "type": "string" },
        "serviceInterest": { "type": "string" },
        "assignedTo": { "type": "string" },
        "notes": { "type": "string" },
        "leadId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "customerName", "contactPerson", "email", "stage", "expectedValueDZD", "probability"]
    },
    "Project": {
      "title": "Project",
      "description": "Active, ongoing, and completed software & ERP implementation projects",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectName": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "status": { "type": "string" },
        "budgetDZD": { "type": "number" },
        "monthlySupportDZD": { "type": "number" },
        "startDate": { "type": "string" },
        "targetEndDate": { "type": "string" },
        "progress": { "type": "number" },
        "projectManager": { "type": "string" },
        "keyDeliverables": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["projectName", "customerName", "status", "budgetDZD", "startDate", "progress"]
    },
    "Claim": {
      "title": "Claim",
      "description": "Client support tickets, bug reports, and ISO 9001 CAPA complaints",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "claimNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "correctiveAction": { "type": "string" },
        "assignedTo": { "type": "string" },
        "resolvedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["claimNumber", "customerName", "contactPerson", "email", "title", "category", "severity", "status", "description"]
    },
    "WorkProject": {
      "title": "WorkProject",
      "description": "Public portfolio case studies and deliverables managed and fulfilled from the admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "solution": { "type": "string" },
        "delivered": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "metricValue": { "type": "string" },
        "metricLabel": { "type": "string" },
        "clientWebsite": { "type": "string" },
        "logoLetter": { "type": "string" },
        "published": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "industry", "description", "solution", "published"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "System users with assigned roles and access permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "sales_manager", "sales_rep", "support_agent", "project_manager", "viewer"] },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended"] },
        "department": { "type": "string" },
        "title": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "email", "role", "status"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Lead and booking inquiries submitted through the website or admin panel."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Accounts and customer directory."
    },
    "/opportunities/{opportunityId}": {
      "schema": { "$ref": "#/entities/Opportunity" },
      "description": "Commercial pipeline deals and sales opportunities."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Client ERP and custom software projects."
    },
    "/claims/{claimId}": {
      "schema": { "$ref": "#/entities/Claim" },
      "description": "Customer claims, incident tickets, and ISO corrective actions."
    },
    "/work_projects/{projectId}": {
      "schema": { "$ref": "#/entities/WorkProject" },
      "description": "Portfolio work and client case studies displayed on the public site."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/AppUser" },
      "description": "Internal CRM users, staff, and their assigned roles and permissions."
    }
  }
}
